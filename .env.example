# Copy this file to .env and fill in your values. Never commit .env.

# Required. YouTube Data API v3 key from https://console.cloud.google.com/
# (APIs & Services > Credentials). Restrict it to the YouTube Data API v3.
YOUTUBE_API_KEY=

# Optional. Set to false to turn off the frame tools (get_video_frames and
# sample_video_frames). Frame fetching violates YouTube's Terms of Service;
# see the README disclaimer. Default: true.
# CLIPCITE_ENABLE_FRAMES=false

# Optional. Full path to ffmpeg, if it isn't on PATH (needed only for the frame tools).
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
